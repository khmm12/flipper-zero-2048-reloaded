App(
    appid="game_2048_reloaded",
    name="2048 Reloaded",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="game_2048_app",
    requires=[
        "gui",
    ],
    stack_size=1 * 1024,
    order=90,
    fap_icon="game_2048.png",
    fap_category="Games",
    fap_author="@khmm12",
    fap_version="1.1",
    fap_description="Play the port of the 2048 game on Flipper Zero.",
    fap_weburl="https://github.com/khmm12/flipper-zero-2048-game",
    sources=["*.c"],  # keep host-only test/ sources out of the firmware build
)
